{
  "name": "pauze-applications",
  "version": "1.2.0",
  "description": "Production-ready Discord application management by PauzeDevs with native forms, review workflows, automation foundations, and a polished UI.",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "register": "tsx src/deploy-commands.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run build"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "better-sqlite3": "^11.8.1",
    "discord.js": "^14.24.2",
    "dotenv": "^17.2.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.18.6",
    "tsx": "^4.19.2",
    "typescript": "^5.9.2"
  },
  "type": "module"
}
